# Shell scripts and Dockerfiles run on Linux: CRLF endings would break the
# shebang and produce "no such file or directory" on the server.
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.conf text eol=lf
*.template text eol=lf

# Everything else: normalise in the repo, check out native.
* text=auto
