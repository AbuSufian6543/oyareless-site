// WirelessCom.Ca Inc. — site + CMS schema
// Datasource URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

enum Role {
  SUPERADMIN
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              Role      @default(EDITOR)
  isActive          Boolean   @default(true)
  mustChangePassword Boolean  @default(false)
  phone             String?
  avatarUrl         String?

  // TOTP two-factor. Secret is stored encrypted-at-rest by the app layer.
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  recoveryCodes     Json?

  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdById       String?
  createdBy         User?     @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers      User[]    @relation("UserCreator")

  sessions          Session[]
  pages             Page[]
  revisions         PageRevision[]
  posts             Post[]
  media             MediaAsset[]
  auditLogs         AuditLog[]
  assignedSubmissions FormSubmission[] @relation("SubmissionAssignee")

  @@index([role])
  @@index([email])
}

/// Server-side session records so that logins can be revoked centrally
/// (a stateless-only JWT could not be invalidated before expiry).
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Throttles credential stuffing / brute force attempts.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  success   Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// ---------------------------------------------------------------------------
// Page builder
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Page {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  navLabel        String?
  status          ContentStatus @default(DRAFT)

  /// Ordered array of block objects. Shape is validated in src/lib/blocks.ts.
  blocks          Json          @default("[]")

  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  noIndex         Boolean       @default(false)

  showInHeaderNav Boolean       @default(false)
  showInFooterNav Boolean       @default(false)
  navOrder        Int           @default(0)

  parentId        String?
  parent          Page?         @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Page[]        @relation("PageTree")

  /// System pages back hard-coded routes (contact, support...) and cannot be
  /// deleted by admins, only edited.
  isSystem        Boolean       @default(false)

  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  authorId        String?
  author          User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  revisions       PageRevision[]

  @@index([status, showInHeaderNav, navOrder])
  @@index([slug])
}

/// Immutable snapshots so an admin can roll a page back after a bad edit.
model PageRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title     String
  blocks    Json
  note      String?
  createdAt DateTime @default(now())
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
}

// ---------------------------------------------------------------------------
// Navigation
// ---------------------------------------------------------------------------

enum NavLocation {
  HEADER
  FOOTER
  UTILITY
}

/// Explicit nav entries. Lets admins add external links and group service
/// pages into dropdowns without touching code.
model NavItem {
  id        String      @id @default(cuid())
  label     String
  href      String
  location  NavLocation @default(HEADER)
  order     Int         @default(0)
  openInNewTab Boolean  @default(false)
  isVisible Boolean     @default(true)
  icon      String?

  parentId  String?
  parent    NavItem?    @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavItem[]   @relation("NavTree")

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([location, order])
}

// ---------------------------------------------------------------------------
// Live streaming
// ---------------------------------------------------------------------------

enum StreamType {
  HLS
  DASH
  YOUTUBE
  VIMEO
  TWITCH
  FACEBOOK
  IFRAME
  MJPEG
  WEBRTC
}

model Stream {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String?
  type          StreamType    @default(HLS)

  /// URL, embed id, or raw iframe src depending on `type`.
  source        String
  posterUrl     String?
  location      String?

  status        ContentStatus @default(DRAFT)
  isLive        Boolean       @default(true)
  featured      Boolean       @default(false)
  order         Int           @default(0)

  /// When set, visitors must enter a password to view. Mirrors the
  /// password-protected camera pages on the legacy site.
  accessPasswordHash String?
  isPublic      Boolean       @default(true)

  autoplay      Boolean       @default(true)
  muted         Boolean       @default(true)
  showControls  Boolean       @default(true)
  aspectRatio   String        @default("16/9")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, order])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// Blog / news
// ---------------------------------------------------------------------------

model Post {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String?
  coverImageUrl   String?
  blocks          Json          @default("[]")
  status          ContentStatus @default(DRAFT)

  metaTitle       String?
  metaDescription String?

  tags            String[]      @default([])
  readingMinutes  Int           @default(3)

  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  authorId        String?
  author          User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// Careers
// ---------------------------------------------------------------------------

model JobPosting {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  department     String?
  location       String        @default("Sault Ste. Marie, ON")
  employmentType String        @default("Full-time")
  summary        String?
  description    String        @default("")
  requirements   String        @default("")
  salaryRange    String?
  attachmentUrl  String?
  status         ContentStatus @default(DRAFT)
  postedAt       DateTime      @default(now())
  closesAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, postedAt])
}

// ---------------------------------------------------------------------------
// Forms, leads, subscribers
// ---------------------------------------------------------------------------

enum SubmissionType {
  CONTACT
  SUPPORT
  QUOTE
  CALLBACK
  APPLICATION
  OTHER
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
  SPAM
}

model FormSubmission {
  id          String           @id @default(cuid())
  type        SubmissionType   @default(CONTACT)
  status      SubmissionStatus @default(NEW)

  name        String
  email       String
  phone       String?
  company     String?
  subject     String?
  message     String

  /// Everything else the form collected (address, service interest, ...).
  payload     Json             @default("{}")

  sourcePage  String?
  ipAddress   String?
  userAgent   String?

  internalNotes String?
  assignedToId String?
  assignedTo   User?           @relation("SubmissionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  emailSentAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model Subscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?
  status       SubscriberStatus @default(PENDING)
  confirmToken String?          @unique
  confirmedAt  DateTime?
  ipAddress    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Media library
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  url          String
  altText      String?
  folder       String   @default("general")
  createdAt    DateTime @default(now())

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([folder, createdAt])
}

// ---------------------------------------------------------------------------
// Social proof
// ---------------------------------------------------------------------------

model Testimonial {
  id         String        @id @default(cuid())
  authorName String
  authorRole String?
  company    String?
  quote      String
  rating     Int           @default(5)
  avatarUrl  String?
  status     ContentStatus @default(PUBLISHED)
  featured   Boolean       @default(false)
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, order])
}

// ---------------------------------------------------------------------------
// Settings, redirects, audit
// ---------------------------------------------------------------------------

/// Key/value store for editable site config (contact details, SMTP display
/// options, feature toggles, analytics snippets...).
model SiteSetting {
  key       String   @id
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

/// Preserves SEO from the legacy Weebly `.html` URLs and lets admins add more.
model Redirect {
  id         String   @id @default(cuid())
  source      String  @unique
  destination String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  hits       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  summary    String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
