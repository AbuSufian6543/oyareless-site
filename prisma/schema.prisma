// WirelessCom.Ca Inc. — site + CMS schema
// Datasource URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

enum Role {
  SUPERADMIN
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              Role      @default(EDITOR)
  isActive          Boolean   @default(true)
  mustChangePassword Boolean  @default(false)
  phone             String?
  avatarUrl         String?

  // TOTP two-factor. Secret is stored encrypted-at-rest by the app layer.
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  recoveryCodes     Json?

  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdById       String?
  createdBy         User?     @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers      User[]    @relation("UserCreator")

  sessions          Session[]
  pages             Page[]
  revisions         PageRevision[]
  posts             Post[]
  media             MediaAsset[]
  auditLogs         AuditLog[]
  assignedSubmissions FormSubmission[] @relation("SubmissionAssignee")
  assignedTickets   Ticket[]         @relation("TicketAssignee")
  ticketReplies     TicketMessage[]  @relation("TicketStaffAuthor")
  passwordResets    PasswordResetToken[]

  @@index([role])
  @@index([email])
}

/// Server-side session records so that logins can be revoked centrally
/// (a stateless-only JWT could not be invalidated before expiry).
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// One-time staff password-reset links, stored hashed. SMTP delivers the
/// plaintext token; a database dump alone cannot be used to reset an account.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Throttles credential stuffing / brute force attempts.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  success   Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// ---------------------------------------------------------------------------
// Page builder
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Page {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  navLabel        String?
  status          ContentStatus @default(DRAFT)

  /// Ordered array of block objects. Shape is validated in src/lib/blocks.ts.
  blocks          Json          @default("[]")

  /// Ordered photos and promo-video links shown as a slideshow on the public
  /// page. Shape is validated in src/lib/slideshow.ts.
  slideshow       Json          @default("[]")

  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  noIndex         Boolean       @default(false)

  showInHeaderNav Boolean       @default(false)
  showInFooterNav Boolean       @default(false)
  navOrder        Int           @default(0)

  parentId        String?
  parent          Page?         @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Page[]        @relation("PageTree")

  /// System pages back hard-coded routes (contact, support...) and cannot be
  /// deleted by admins, only edited.
  isSystem        Boolean       @default(false)

  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  authorId        String?
  author          User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  revisions       PageRevision[]

  @@index([status, showInHeaderNav, navOrder])
  @@index([slug])
}

/// Immutable snapshots so an admin can roll a page back after a bad edit.
model PageRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title     String
  blocks    Json
  slideshow Json     @default("[]")
  note      String?
  createdAt DateTime @default(now())
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
}

// ---------------------------------------------------------------------------
// Navigation
// ---------------------------------------------------------------------------

enum NavLocation {
  HEADER
  FOOTER
  UTILITY
}

/// Explicit nav entries. Lets admins add external links and group service
/// pages into dropdowns without touching code.
model NavItem {
  id        String      @id @default(cuid())
  label     String
  href      String
  location  NavLocation @default(HEADER)
  order     Int         @default(0)
  openInNewTab Boolean  @default(false)
  isVisible Boolean     @default(true)
  icon      String?

  parentId  String?
  parent    NavItem?    @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavItem[]   @relation("NavTree")

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([location, order])
}

// ---------------------------------------------------------------------------
// Live streaming
// ---------------------------------------------------------------------------

enum StreamType {
  HLS
  DASH
  YOUTUBE
  VIMEO
  TWITCH
  FACEBOOK
  IFRAME
  MJPEG
  WEBRTC
  /// Vendor player snippet (Mist / VideoStreamCanada). `source` holds the HTML.
  HTML
}

model Stream {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String?
  type          StreamType    @default(HLS)

  /// URL, embed id, iframe src, or the full HTML snippet when `type` is HTML.
  source        String
  posterUrl     String?
  location      String?

  status        ContentStatus @default(DRAFT)
  isLive        Boolean       @default(true)
  featured      Boolean       @default(false)
  order         Int           @default(0)

  /// When set, visitors must enter a password to view. Mirrors the
  /// password-protected camera pages on the legacy site.
  accessPasswordHash String?
  isPublic      Boolean       @default(true)

  autoplay      Boolean       @default(true)
  muted         Boolean       @default(true)
  showControls  Boolean       @default(true)
  aspectRatio   String        @default("16/9")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, order])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// Blog / news
// ---------------------------------------------------------------------------

model Post {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String?
  coverImageUrl   String?
  blocks          Json          @default("[]")
  status          ContentStatus @default(DRAFT)

  metaTitle       String?
  metaDescription String?

  tags            String[]      @default([])
  readingMinutes  Int           @default(3)

  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  authorId        String?
  author          User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// Careers
// ---------------------------------------------------------------------------

model JobPosting {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  department     String?
  location       String        @default("Sault Ste. Marie, ON")
  employmentType String        @default("Full-time")
  summary        String?
  description    String        @default("")
  requirements   String        @default("")
  salaryRange    String?
  attachmentUrl  String?
  status         ContentStatus @default(DRAFT)
  postedAt       DateTime      @default(now())
  closesAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, postedAt])
}

// ---------------------------------------------------------------------------
// Forms, leads, subscribers
// ---------------------------------------------------------------------------

enum SubmissionType {
  CONTACT
  SUPPORT
  QUOTE
  CALLBACK
  APPLICATION
  OTHER
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
  SPAM
}

model FormSubmission {
  id          String           @id @default(cuid())
  type        SubmissionType   @default(CONTACT)
  status      SubmissionStatus @default(NEW)

  name        String
  email       String
  phone       String?
  company     String?
  subject     String?
  message     String

  /// Everything else the form collected (address, service interest, ...).
  payload     Json             @default("{}")

  sourcePage  String?
  ipAddress   String?
  userAgent   String?

  internalNotes String?
  assignedToId String?
  assignedTo   User?           @relation("SubmissionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  emailSentAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model Subscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?
  status       SubscriberStatus @default(PENDING)
  confirmToken String?          @unique
  confirmedAt  DateTime?
  ipAddress    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Media library
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  url          String
  altText      String?
  folder       String   @default("general")
  createdAt    DateTime @default(now())

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([folder, createdAt])
}

// ---------------------------------------------------------------------------
// Social proof
// ---------------------------------------------------------------------------

model Testimonial {
  id         String        @id @default(cuid())
  authorName String
  authorRole String?
  company    String?
  quote      String
  rating     Int           @default(5)
  avatarUrl  String?
  status     ContentStatus @default(PUBLISHED)
  featured   Boolean       @default(false)
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, order])
}

// ---------------------------------------------------------------------------
// Settings, redirects, audit
// ---------------------------------------------------------------------------

/// Key/value store for editable site config (contact details, SMTP display
/// options, feature toggles, analytics snippets...).
model SiteSetting {
  key       String   @id
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

/// Preserves SEO from the legacy Weebly `.html` URLs and lets admins add more.
model Redirect {
  id         String   @id @default(cuid())
  source      String  @unique
  destination String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  hits       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  summary    String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Service catalog, brands, FAQ, knowledge base, case studies
//
// Each of these gets an admin CRUD section and a public page. They carry their
// own slug and SEO fields so they are addressable independently of the page
// builder, and a `blocks` column where long-form content is needed so the same
// block editor can be reused.
// ---------------------------------------------------------------------------

model ServiceCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services    Service[]

  @@index([order])
}

model Service {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  summary         String        @default("")
  icon            String?
  imageUrl        String?
  imageAlt        String?

  /// Long-form body, validated by src/lib/blocks.ts like any page.
  blocks          Json          @default("[]")

  status          ContentStatus @default(DRAFT)
  featured        Boolean       @default(false)
  order           Int           @default(0)

  metaTitle       String?
  metaDescription String?

  categoryId      String?
  category        ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  quoteRequests   QuoteRequest[]

  @@index([status, order])
  @@index([categoryId, order])
}

model Brand {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  logoUrl     String?
  websiteUrl  String?

  /// What the business actually does with this vendor's equipment. Kept as
  /// free text so relationship claims stay accurate and editable.
  category    String        @default("")
  description String        @default("")

  /// Only set where a formal relationship exists, e.g. "Authorized Dealer".
  relationship String?

  status      ContentStatus @default(PUBLISHED)
  featured    Boolean       @default(false)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, order])
}

model FaqItem {
  id        String        @id @default(cuid())
  question  String
  answer    String
  category  String        @default("General")
  status    ContentStatus @default(PUBLISHED)
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, category, order])
}

model KbCategory {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  icon        String?
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  articles    KbArticle[]

  @@index([order])
}

model KbArticle {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  summary         String        @default("")
  blocks          Json          @default("[]")
  status          ContentStatus @default(DRAFT)
  featured        Boolean       @default(false)
  order           Int           @default(0)

  metaTitle       String?
  metaDescription String?

  /// Incremented on view so the most-read articles can be surfaced.
  views           Int           @default(0)

  categoryId      String?
  category        KbCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, order])
  @@index([categoryId, order])
}

model CaseStudy {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  sector          String        @default("")
  clientName      String?

  /// The four narrative stages the marketing pages render.
  problem         String        @default("")
  solution        String        @default("")
  implementation  String        @default("")
  result          String        @default("")

  blocks          Json          @default("[]")
  imageUrl        String?
  imageAlt        String?

  status          ContentStatus @default(DRAFT)
  featured        Boolean       @default(false)
  order           Int           @default(0)

  metaTitle       String?
  metaDescription String?

  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, order])
}

// ---------------------------------------------------------------------------
// Admin-managed embeds
// ---------------------------------------------------------------------------

enum EmbedPlacement {
  PAGE
  HEAD
  BODY_END
}

/// Named third-party embeds (dashboards, maps, camera feeds) so an admin can
/// paste markup once and reference it by name. Rendered through a sanitiser.
model EmbedSnippet {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String?
  html        String
  placement   EmbedPlacement @default(PAGE)

  /// Empty means "available anywhere"; otherwise a list of page slugs.
  allowedPages String[]      @default([])

  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Monitoring and incidents
//
// Every figure shown on the public status pages originates here, from probes
// this application runs against endpoints an admin configured. Nothing is
// synthesised: with no endpoints, the status surfaces say so.
// ---------------------------------------------------------------------------

enum ProbeKind {
  HTTP
  TCP
  DNS
}

model MonitoredEndpoint {
  id            String        @id @default(cuid())
  name          String
  /// Stable key for seed upserts and logo files. Never shown to visitors.
  slug          String        @unique
  kind          ProbeKind     @default(HTTP)

  /// URL for HTTP, host for TCP/DNS. Server-only — never sent to the browser.
  target        String
  /// Homepage visitors may open. Omit for internal monitors.
  websiteUrl    String?
  /// Shipped or uploaded mark for the public status cards.
  logoUrl       String?
  /// Grouping label on /network-status (e.g. Health, Education).
  category      String        @default("")
  port          Int?
  /// HTTP status treated as healthy; ignored for TCP/DNS.
  expectStatus  Int           @default(200)
  timeoutMs     Int           @default(5000)
  intervalSec   Int           @default(300)

  enabled       Boolean       @default(true)
  /// Internal-only endpoints are monitored but never shown to visitors.
  isPublic      Boolean       @default(true)
  order         Int           @default(0)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  checks        StatusCheck[]

  @@index([enabled, isPublic, order])
}

model StatusCheck {
  id         String            @id @default(cuid())
  endpointId String
  endpoint   MonitoredEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  ok         Boolean
  latencyMs  Int?
  statusCode Int?
  error      String?
  checkedAt  DateTime          @default(now())

  @@index([endpointId, checkedAt])
  @@index([checkedAt])
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
  MAINTENANCE
}

model Incident {
  id          String            @id @default(cuid())
  title       String
  severity    IncidentSeverity  @default(MINOR)
  /// Free text so an admin can name affected services precisely.
  affected    String            @default("")
  startedAt   DateTime          @default(now())
  resolvedAt  DateTime?
  isPublic    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  updates     IncidentUpdate[]

  @@index([resolvedAt, startedAt])
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}

model MaintenanceWindow {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  affected    String   @default("")
  startsAt    DateTime
  endsAt      DateTime
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt])
}

// ---------------------------------------------------------------------------
// Tool abuse control
// ---------------------------------------------------------------------------

/// Records network/security tool invocations so abuse can be reviewed and
/// blocked. Deliberately stores a hashed client IP rather than the address.
model ToolUsageLog {
  id         String   @id @default(cuid())
  tool       String
  target     String
  ipHash     String
  ok         Boolean  @default(true)
  durationMs Int?
  error      String?
  createdAt  DateTime @default(now())

  @@index([tool, createdAt])
  @@index([ipHash, createdAt])
}

// ---------------------------------------------------------------------------
// Speed test results
// ---------------------------------------------------------------------------

/// Persisted so a completed test can be shared by link. Contains no personal
/// data beyond a coarse network descriptor and a hashed IP.
model SpeedTestResult {
  id           String   @id @default(cuid())
  shareToken   String   @unique
  downloadMbps Float
  uploadMbps   Float
  latencyMs    Float
  jitterMs     Float
  /// Reverse-DNS derived descriptor, e.g. "rogers.com". Never an IP address.
  networkName  String?
  ipHash       String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Customer portal
//
// Deliberately separate from `User`: a portal account has no role field and no
// relation into the admin tables, so it can never reach /admin.
// ---------------------------------------------------------------------------

model Customer {
  id           String   @id @default(cuid())
  name         String
  accountRef   String?  @unique
  phone        String?
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  province     String?
  postalCode   String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        CustomerUser[]
  tickets      Ticket[]
  quotes       QuoteRequest[]
  documents    CustomerDocument[]
  services     CustomerServiceItem[]

  @@index([isActive])
}

model CustomerUser {
  id                 String    @id @default(cuid())
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  email              String    @unique
  name               String
  passwordHash       String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)

  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecret    String?
  recoveryCodes      Json?

  /// Single-use token for the invite / reset flow.
  inviteTokenHash    String?
  inviteExpiresAt    DateTime?

  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions           CustomerSession[]
  ticketMessages     TicketMessage[]
  createdTickets     Ticket[]  @relation("TicketCreator")

  @@index([customerId])
}

model CustomerSession {
  id             String       @id @default(cuid())
  customerUserId String
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())

  @@index([customerUserId])
  @@index([expiresAt])
}

model CustomerServiceItem {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  status      String   @default("Active")
  startedAt   DateTime?
  renewsAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model CustomerDocument {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  url         String
  mimeType    String   @default("application/pdf")
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
}

// ---------------------------------------------------------------------------
// Support ticketing
// ---------------------------------------------------------------------------

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

model Ticket {
  id             String         @id @default(cuid())
  /// Short human reference shown to customers, e.g. WC-1042.
  reference      String         @unique
  subject        String
  category       String         @default("General")
  status         TicketStatus   @default(NEW)
  priority       TicketPriority @default(NORMAL)

  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Null when a staff member opened the ticket on the customer's behalf.
  createdById    String?
  createdBy      CustomerUser?  @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// Staff owner. SetNull so deactivating a technician never deletes tickets.
  assignedToId   String?
  assignedTo     User?          @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  firstResponseAt DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  messages       TicketMessage[]

  @@index([customerId, status])
  @@index([status, priority, createdAt])
  @@index([assignedToId, status])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  body       String

  /// Exactly one author side is set.
  authorCustomerUserId String?
  authorCustomerUser   CustomerUser? @relation(fields: [authorCustomerUserId], references: [id], onDelete: SetNull)
  authorStaffId        String?
  authorStaff          User?         @relation("TicketStaffAuthor", fields: [authorStaffId], references: [id], onDelete: SetNull)
  /// Denormalised so a reply keeps its byline after the account is removed.
  authorStaffName      String?

  /// Internal notes are never returned to the portal.
  isInternal Boolean  @default(false)

  createdAt  DateTime @default(now())

  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
}

model TicketAttachment {
  id        String        @id @default(cuid())
  messageId String
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename  String
  url       String
  mimeType  String
  sizeBytes Int
  createdAt DateTime      @default(now())

  @@index([messageId])
}

// ---------------------------------------------------------------------------
// Quote requests
// ---------------------------------------------------------------------------

enum QuoteStatus {
  NEW
  REVIEWING
  QUOTED
  WON
  LOST
  CANCELLED
}

model QuoteRequest {
  id            String      @id @default(cuid())
  reference     String      @unique
  status        QuoteStatus @default(NEW)

  contactName   String
  email         String
  phone         String?
  companyName   String?
  siteAddress   String?

  /// Free-text project brief plus structured extras from the form.
  details       String      @default("")
  payload       Json        @default("{}")
  timeframe     String?
  budgetRange   String?

  /// Optional link to a catalog entry when the visitor picked one.
  serviceId     String?
  service       Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceAreas  String[]    @default([])

  /// Set once the request is matched to an existing customer.
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  internalNotes String?
  respondedAt   DateTime?

  sourcePage    String?
  ipAddress     String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  attachments   QuoteAttachment[]

  @@index([status, createdAt])
}

model QuoteAttachment {
  id        String       @id @default(cuid())
  quoteId   String
  quote     QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  filename  String
  url       String
  mimeType  String
  sizeBytes Int
  createdAt DateTime     @default(now())

  @@index([quoteId])
}
