# ---------------------------------------------------------------------------
# WirelessCom.Ca Inc. — environment configuration
#
# For deployment you do NOT need this file: deploy.sh writes a .env with freshly
# generated secrets. Copy this template only for local development, and replace
# every "change-me" / "generate-with-..." value — deploy.sh refuses to start
# with the placeholders still in place.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
POSTGRES_USER=wirelesscom
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=wirelesscom
DATABASE_URL=postgresql://wirelesscom:change-me-strong-password@db:5432/wirelesscom?schema=public

# --- App -------------------------------------------------------------------
# Public origin used for canonical URLs, sitemap, and email links.
NEXT_PUBLIC_SITE_URL=https://wirelesscom.ca
NODE_ENV=production
# Host port the container publishes on, and the host address it binds to.
# 127.0.0.1 keeps the app private behind nginx; 0.0.0.0 exposes it directly.
APP_PORT=3000
APP_BIND=127.0.0.1

# Set to false to skip the content seed on the next start.
RUN_SEED=true

# 32+ byte random string used to sign session cookies. MUST be changed.
AUTH_SECRET=generate-with-openssl-rand-base64-48

# Key used to encrypt TOTP secrets at rest (32+ bytes).
ENCRYPTION_KEY=generate-with-openssl-rand-base64-48

# Set to "true" only when serving over plain HTTP (e.g. bare IP access with no
# TLS). Leave false in production so session cookies stay Secure-only.
ALLOW_INSECURE_COOKIES=false

# --- Initial super admin (seeded once) -------------------------------------
SUPERADMIN_EMAIL=abu@wirelesscom.ca
SUPERADMIN_PASSWORD=HospitalRoad111#
SUPERADMIN_NAME=Abu

# --- SMTP ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Envelope sender. Many providers require this to match SMTP_USER's domain.
SMTP_FROM="WirelessCom.Ca Inc. <no-reply@wirelesscom.ca>"
# Where contact/support/quote form notifications are delivered.
SMTP_TO=service@wirelesscom.ca

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=/app/public/uploads
MAX_UPLOAD_MB=25
